rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'createdAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 3
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'sportId', 'organizerId', 'venueName', 'title', 'format',
          'kind', 'pricePerPlayer', 'startsAt',
          'maxPlayers', 'playerIds', 'createdAt'
        ])
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.sportId in ['padel']
        && request.resource.data.maxPlayers == 4
        && request.resource.data.venueName is string
        && request.resource.data.venueName.size() >= 2
        && request.resource.data.venueName.size() <= 60
        && request.resource.data.startsAt is timestamp
        && request.resource.data.startsAt > request.time
        && request.resource.data.playerIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 40
        && request.resource.data.format in ['sets', 'tournament']
        && request.resource.data.kind in ['friendly', 'ranked']
        && request.resource.data.pricePerPlayer is int
        && request.resource.data.pricePerPlayer >= 0
        && request.resource.data.pricePerPlayer <= 1000;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['playerIds'])
        && (
          // join: add yourself, and do not exceed maxPlayers
          (
            !(request.auth.uid in resource.data.playerIds)
            && request.resource.data.playerIds ==
              resource.data.playerIds.concat([request.auth.uid])
            && request.resource.data.playerIds.size()
              <= resource.data.maxPlayers
          )
          // leave: remove yourself, unless you are the organizer
          || (
            request.auth.uid in resource.data.playerIds
            && request.auth.uid != resource.data.organizerId
            && request.resource.data.playerIds ==
              resource.data.playerIds.removeAll([request.auth.uid])
          )
        );

      allow delete: if false;
    }
  }
}